new file mode 100644
--- /dev/null
+++ b/zsh/termbrana/claude_adapter.py
@@ -0,0 +1,83 @@
+"""Synthetic Claude Code 2.1.286 fixture adapter.
+
+The native transcript schema is not qualified. This module only parses explicitly
+supplied bytes matching the frozen synthetic fixture and keeps unknown semantics visible.
+"""
+
+import json
+
+
+class SourceError(ValueError):
+    pass
+
+
+def _body(record):
+    message = record.get("message")
+    if not isinstance(message, dict):
+        raise SourceError(f"missing message object: {record.get('uuid', 'no-uuid')}")
+    content = message.get("content")
+    if isinstance(content, str):
+        return content, []
+    if isinstance(content, list):
+        texts = [part.get("text") for part in content if isinstance(part, dict) and part.get("type") == "text"]
+        omitted = [part.get("type", "object_without_type") if isinstance(part, dict) else "non_object" for part in content if not isinstance(part, dict) or part.get("type") != "text"]
+        if texts and all(isinstance(text, str) for text in texts):
+            return "\n".join(texts), omitted
+    raise SourceError(f"unsupported message content: {record.get('uuid', 'no-uuid')}")
+
+
+def parse(data: bytes) -> dict:
+    """Return main-line exchanges and explicit disclosures for synthetic fixture bytes."""
+    exchanges, disclosures = [], []
+    session_id = None
+    last_uuid = None
+    seen = set()
+    for line_number, raw_line in enumerate(data.splitlines(keepends=True), 1):
+        if not raw_line.endswith(b"\n"):
+            disclosures.append({"kind": "incomplete_final_line", "line": line_number})
+            break
+        try:
+            record = json.loads(raw_line)
+        except json.JSONDecodeError as exc:
+            raise SourceError(f"malformed complete JSONL record at line {line_number}: {exc.msg}") from exc
+        if not isinstance(record, dict):
+            raise SourceError(f"non-object record at line {line_number}")
+        current_session = record.get("sessionId")
+        if not isinstance(current_session, str) or not current_session:
+            raise SourceError(f"missing session identity at line {line_number}")
+        if session_id is None:
+            session_id = current_session
+        elif session_id != current_session:
+            raise SourceError("source mixes session identities")
+        kind, uuid = record.get("type"), record.get("uuid")
+        if isinstance(uuid, str):
+            if uuid in seen:
+                raise SourceError(f"duplicate source UUID at line {line_number}: {uuid}")
+            seen.add(uuid)
+        if kind == "last-prompt":
+            source_uuid = record.get("sourceUuid")
+            disclosures.append({"kind": "duplicate_representation", "uuid": uuid, "source_uuid": source_uuid})
+            continue
+        if kind == "permission-mode":
+            disclosures.append({"kind": "permission_mode", "mode": record.get("permissionMode"), "approval_outcome": "unknown"})
+            continue
+        if kind not in {"user", "assistant"}:
+            disclosures.append({"kind": "unsupported", "type": kind, "uuid": uuid, "semantics": "unknown"})
+            continue
+        if not isinstance(uuid, str) or not uuid:
+            raise SourceError(f"missing exchange UUID at line {line_number}")
+        parent = record.get("parentUuid")
+        if not exchanges:
+            main_line = parent is None
+        else:
+            main_line = parent == last_uuid
+        body, omitted = _body(record)
+        exchange = {"uuid": uuid, "role": kind, "timestamp": record.get("timestamp"), "body": body, "omitted_content": omitted}
+        if not main_line:
+            disclosures.append({"kind": "alternate_branch", "uuid": uuid, "parent_uuid": parent, "main_line_resolution": "refused"})
+            continue
+        exchanges.append(exchange)
+        last_uuid = uuid
+    if session_id is None or not exchanges:
+        raise SourceError("source contains no canonical exchanges")
+    return {"vendor": "claude-code", "vendor_version": "2.1.286", "session_id": session_id, "exchanges": exchanges, "disclosures": disclosures, "native_schema": "unqualified"}
diff --git a/zsh/termbrana/codex_native.py b/zsh/termbrana/codex_native.py
new file mode 100644
--- /dev/null
+++ b/zsh/termbrana/codex_native.py
@@ -0,0 +1,306 @@
+#!/usr/bin/env python3
+"""Conservative, explicitly versioned reader for Codex public rollout JSONL.
+
+This is deliberately separate from ``transcript.py``.  It reads only bytes supplied
+by its caller and models the public, tagged rollout envelope; it neither discovers nor
+opens a Codex home directory.  Native qualification still requires an isolated
+operator-produced rollout from the target build.
+
+Sources (tag rust-v0.166.0):
+* codex-rs/rollout/src/lib.rs: ``RolloutLine`` and the canonical decoder.
+* codex-rs/history/src/rollout_payload.rs: the ``type``/``payload`` item wire form.
+* codex-rs/protocol/src/protocol.rs: ``SessionMeta`` and message event payloads.
+
+The explicit 0.167.0 subset additionally follows rust-v0.167.0
+``protocol/src/{protocol,items,user_input}.rs`` completed-item text definitions.
+It renders completed items only; alternate event/response representations stay
+disclosed and do not become a second copy of a message.
+"""
+
+import json
+
+
+class SourceError(ValueError):
+    """The supplied bytes cannot be read under this deliberately narrow contract."""
+
+
+CONVERSATION_EVENTS = {"user_message": "user", "agent_message": "assistant"}
+SUPPORTED_HISTORY_MODES = {"legacy", "paginated"}
+
+
+def _require_string(value, field, line):
+    if not isinstance(value, str) or not value:
+        raise SourceError(f"missing {field} at line {line}")
+    return value
+
+
+def _location(line, offset, ordinal, thread_id):
+    """Return an explicit snapshot-bound reader pin.
+
+    A paginated ordinal locates a record in this captured rollout, but it is not a
+    universal durable identity: a revert can retain a stable thread ID while writing
+    a distinct rollout ID.  Carrying an ordinal into another snapshot therefore
+    requires separately validated capture continuity.  Legacy history has no native
+    per-item identifier at all.
+    """
+    if ordinal is not None:
+        return {
+            "id": f"snapshot:thread:{thread_id}:ordinal:{ordinal}",
+            "kind": "snapshot_bound_rollout_ordinal",
+            "thread_id": thread_id,
+            "ordinal": ordinal,
+            "snapshot_bound": True,
+            "carry_forward_requires": "validated_capture_continuity",
+            "source_line": line,
+            "source_offset": offset,
+        }
+    return {
+        "id": f"snapshot:line:{line}:offset:{offset}",
+        "kind": "snapshot_relative_position",
+        "snapshot_relative": True,
+        "carry_forward_requires": "validated_capture_continuity",
+        "source_line": line,
+        "source_offset": offset,
+    }
+
+
+def _parse_meta(payload, line):
+    if not isinstance(payload, dict):
+        raise SourceError(f"session_meta payload must be an object at line {line}")
+    history_mode = payload.get("history_mode", "legacy")
+    if history_mode not in SUPPORTED_HISTORY_MODES:
+        raise SourceError(f"unsupported session_meta.history_mode at line {line}: {history_mode!r}")
+    meta = {
+        "thread_id": _require_string(payload.get("id"), "session_meta.id", line),
+        "session_id": _require_string(payload.get("session_id"), "session_meta.session_id", line),
+        "forked_from_id": payload.get("forked_from_id"),
+        "attached_thread": payload.get("attached_thread", False),
+        "forked_from_ordinal_exclusive": payload.get("forked_from_ordinal_exclusive"),
+        "parent_thread_id": payload.get("parent_thread_id"),
+        "history_mode": history_mode,
+        "history_base": payload.get("history_base"),
+        "subagent_history_start_ordinal": payload.get("subagent_history_start_ordinal"),
+    }
+    if payload.get("cli_version") is not None:
+        meta["producer_version"] = payload["cli_version"]
+    return meta
+
+
+def parse(data: bytes, contract_version: str = "0.166.0") -> dict:
+    """Parse a source-derived subset of a Codex rollout JSONL snapshot.
+
+    Only the selected version's complete text representation becomes exchanges. Every other
+    native representation stays visible as a disclosure rather than being guessed as
+    a user-visible message.  In particular, ``response_item`` is not rendered: it
+    can be an alternate persisted representation, but this reader cannot establish
+    duplicate semantics from the file alone.
+    """
+    if contract_version not in {"0.166.0", "0.167.0"}:
+        raise SourceError("unsupported Codex adapter contract version")
+    exchanges, disclosures, seen_pins = [], [], set()
+    completed_items = {}
+    meta, offset, complete_records = None, 0, 0
+    deferred_partial = False
+
+    for line_number, raw_line in enumerate(data.splitlines(keepends=True), 1):
+        line_offset = offset
+        if not raw_line.endswith(b"\n"):
+            deferred_partial = True
+            disclosures.append({
+                "kind": "incomplete_final_line",
+                "source_line": line_number,
+                "source_offset": line_offset,
+                "semantics": "not parsed or rendered",
+            })
+            break
+        offset += len(raw_line)
+        try:
+            record = json.loads(raw_line)
+        except json.JSONDecodeError as exc:
+            raise SourceError(f"malformed complete JSONL record at line {line_number}: {exc.msg}") from exc
+        if not isinstance(record, dict):
+            raise SourceError(f"rollout record must be an object at line {line_number}")
+        timestamp = _require_string(record.get("timestamp"), "rollout timestamp", line_number)
+        ordinal = record.get("ordinal")
+        if ordinal is not None and (not isinstance(ordinal, int) or isinstance(ordinal, bool) or ordinal < 0):
+            raise SourceError(f"invalid rollout ordinal at line {line_number}")
+
+        kind, payload = record.get("type"), record.get("payload")
+        if complete_records == 0:
+            if kind != "session_meta":
+                raise SourceError("rollout must begin with session_meta")
+            meta = _parse_meta(payload, line_number)
+            producer = meta.get("producer_version")
+            if producer is not None and producer != contract_version:
+                raise SourceError("session_meta.cli_version does not match adapter contract")
+            if contract_version == "0.167.0" and producer is None:
+                raise SourceError("0.167 adapter requires session_meta.cli_version")
+        elif kind == "session_meta":
+            raise SourceError(f"duplicate session_meta at line {line_number}")
+        complete_records += 1
+
+        if meta["history_mode"] == "paginated" and ordinal is None:
+            raise SourceError(f"paginated rollout record missing ordinal at line {line_number}")
+        pin = _location(line_number, line_offset, ordinal, meta["thread_id"])
+        if pin["id"] in seen_pins:
+            raise SourceError(f"duplicate rollout position at line {line_number}: {pin['id']}")
+        seen_pins.add(pin["id"])
+
+        if kind == "session_meta":
+            continue
+        if kind == "response_item":
+            disclosures.append({
+                "kind": "potential_duplicate_representation",
+                "native_type": "response_item",
+                "response_item_type": payload.get("type") if isinstance(payload, dict) else None,
+                "pin": pin,
+                "semantics": "not rendered; relation to event_msg is unknown",
+            })
+            continue
+        if kind == "compacted":
+            disclosures.append({
+                "kind": "compacted_history",
+                "pin": pin,
+                "semantics": "not rendered; prior context may have been replaced",
+            })
+            continue
+        if kind != "event_msg" or not isinstance(payload, dict):
+            disclosures.append({
+                "kind": "unsupported_rollout_item",
+                "native_type": kind,
+                "pin": pin,
+                "semantics": "not rendered",
+            })
+            continue
+
+        event_type = payload.get("type")
+        if contract_version == "0.167.0" and event_type == "item_completed":
+            if payload.get("thread_id") != meta["thread_id"]:
+                raise SourceError(f"completed item thread mismatch at line {line_number}")
+            turn = _require_string(payload.get("turn_id"), "item_completed.turn_id", line_number)
+            item = payload.get("item")
+            if not isinstance(item, dict):
+                raise SourceError(f"completed item must be an object at line {line_number}")
+            item_type = item.get("type")
+            if item_type == "ContextCompaction":
+                disclosures.append({"kind": "context_compaction", "pin": pin,
+                                    "semantics": "completed compaction; context reconstruction unavailable"})
+                continue
+            role = {"UserMessage": "user", "AgentMessage": "assistant"}.get(item_type)
+            if role is None:
+                disclosures.append({"kind": "unsupported_completed_item", "item_type": item_type,
+                                    "pin": pin, "semantics": "not rendered"})
+                continue
+            item_id = _require_string(item.get("id"), "item.id", line_number)
+            content = item.get("content")
+            if not isinstance(content, list):
+                raise SourceError(f"completed item content must be a list at line {line_number}")
+            expected_text_type = "text" if role == "user" else "Text"
+            texts, omitted = [], []
+            for chunk in content:
+                if not isinstance(chunk, dict):
+                    raise SourceError(f"completed item content must contain objects at line {line_number}")
+                if chunk.get("type") == expected_text_type:
+                    if not isinstance(chunk.get("text"), str):
+                        raise SourceError(f"completed item text must be a string at line {line_number}")
+                    texts.append(chunk["text"])
+                else:
+                    omitted.append(chunk.get("type"))
+            fingerprint = json.dumps({"turn": turn, "item": item}, sort_keys=True)
+            if item_id in completed_items:
+                if completed_items[item_id] != fingerprint:
+                    raise SourceError(f"conflicting completed item identity at line {line_number}")
+                disclosures.append({"kind": "duplicate_completed_item", "item_id": item_id,
+                                    "pin": pin, "semantics": "identical item rendered once"})
+                continue
+            completed_items[item_id] = fingerprint
+            if omitted:
+                disclosures.append({"kind": "omitted_content", "types": omitted,
+                                    "pin": pin, "semantics": "non-text content not rendered"})
+            extra = sorted(key for key in item if key not in {"type", "id", "content", "phase", "client_id"}
+                           and item[key] is not None)
+            if extra:
+                disclosures.append({"kind": "unsupported_item_metadata", "fields": extra,
+                                    "pin": pin, "semantics": "not rendered"})
+            if not texts:
+                continue
+            pin.update({"native_item_id": item_id, "turn_id": turn})
+            if item.get("phase") is not None:
+                pin["native_phase"] = item["phase"]
+            exchanges.append({"id": pin["id"], "role": role, "body": "\n".join(texts),
+                              "timestamp": timestamp, "pin": pin, "phase": item.get("phase")})
+            continue
+        if event_type == "thread_rolled_back":
+            disclosures.append({
+                "kind": "thread_rolled_back",
+                "pin": pin,
+                "semantics": "not rendered; persisted rollback removes earlier user turns",
+            })
+            continue
+        if event_type == "context_compacted":
+            disclosures.append({
+                "kind": "context_compaction",
+                "pin": pin,
+                "semantics": "not rendered; adapter does not reconstruct replaced context",
+            })
+            continue
+        role = CONVERSATION_EVENTS.get(event_type)
+        if contract_version == "0.167.0" and role is not None:
+            disclosures.append({"kind": "potential_duplicate_representation", "event_type": event_type,
+                                "pin": pin, "semantics": "only completed items rendered in 0.167 contract"})
+            continue
+        if role is None:
+            disclosures.append({
+                "kind": "unsupported_event",
+                "event_type": event_type,
+                "pin": pin,
+                "semantics": "not rendered",
+            })
+            continue
+        message = payload.get("message")
+        if not isinstance(message, str):
+            raise SourceError(f"{event_type}.message must be a string at line {line_number}")
+        exchanges.append({
+            "id": pin["id"],
+            "role": role,
+            "body": message,
+            "timestamp": timestamp,
+            "pin": pin,
+            "phase": payload.get("phase"),
+        })
+
+    if meta is None:
+        raise SourceError("source contains no complete rollout metadata")
+    if not exchanges:
+        raise SourceError("source contains no supported conversation events")
+    lineage_present = (
+        meta["forked_from_id"] is not None
+        or meta["attached_thread"] is True
+        or meta["forked_from_ordinal_exclusive"] is not None
+        or meta["parent_thread_id"] is not None
+        or meta["history_base"] is not None
+        or meta["subagent_history_start_ordinal"] is not None
+    )
+    if lineage_present:
+        disclosures.append({
+            "kind": "fork_or_history_base",
+            "thread_id": meta["thread_id"],
+            "forked_from_id": meta["forked_from_id"],
+            "attached_thread": meta["attached_thread"],
+            "forked_from_ordinal_exclusive": meta["forked_from_ordinal_exclusive"],
+            "parent_thread_id": meta["parent_thread_id"],
+            "history_base": meta["history_base"],
+            "subagent_history_start_ordinal": meta["subagent_history_start_ordinal"],
+            "semantics": "lineage/inherited history disclosed; this adapter does not merge another rollout",
+        })
+    return {
+        "vendor": "codex",
+        "vendor_version": meta.get("producer_version"),
+        "adapter_contract": contract_version + "-source-derived",
+        "identity": meta,
+        "exchanges": exchanges,
+        "disclosures": disclosures,
+        "deferred_partial": deferred_partial,
+        "complete_bytes": offset,
+        "native_qualification": "unqualified_without_isolated_operator_rollout",
+    }
diff --git a/zsh/termbrana/collector.py b/zsh/termbrana/collector.py
new file mode 100644
--- /dev/null
+++ b/zsh/termbrana/collector.py
@@ -0,0 +1,291 @@
+#!/usr/bin/env python3
+"""Foreground collection for immutable transcript snapshots.
+
+This module only polls an explicitly supplied file.  It neither discovers nor resumes
+native sessions, starts an editor, nor runs after its command exits.
+"""
+
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import time
+
+
+_TRANSCRIPT_PATH = Path(__file__).with_name("transcript.py")
+_TRANSCRIPT_SPEC = importlib.util.spec_from_file_location("termbrana_transcript", _TRANSCRIPT_PATH)
+if _TRANSCRIPT_SPEC is None or _TRANSCRIPT_SPEC.loader is None:
+    raise RuntimeError("unable to load adjacent transcript engine")
+transcript = importlib.util.module_from_spec(_TRANSCRIPT_SPEC)
+_TRANSCRIPT_SPEC.loader.exec_module(transcript)
+
+
+class CollectionError(ValueError):
+    pass
+
+
+def _selection_path(cache: Path) -> Path:
+    return cache / "selected.json"
+
+
+def _write_selection(cache: Path, snapshot: str, record: str | None = None) -> None:
+    bundle, metadata = transcript.resolve_bundle(cache, snapshot)
+    del bundle
+    payload = {
+        "snapshot": snapshot,
+        "map_sha256": transcript.digest((cache / "snapshots" / snapshot / "map.json").read_bytes()),
+        "identity": metadata["identity"],
+    }
+    if record is not None:
+        payload["record"] = record
+    transcript.atomic_write(
+        _selection_path(cache),
+        (json.dumps(payload, sort_keys=True) + "\n").encode(),
+    )
+
+
+def _select_and_materialize(cache: Path, snapshot: str, record: str | None = None) -> Path | None:
+    """Commit pointer, then derive its reading copy under the selection lock.
+
+    A hard interruption can separate these writes. Implicit readers reject the
+    mismatch and status/collect/refresh repair the copy from the committed pointer.
+    """
+    with transcript.selection_lock(cache):
+        return _select_and_materialize_locked(cache, snapshot, record)
+
+
+def _select_and_materialize_locked(cache: Path, snapshot: str, record: str | None = None) -> Path | None:
+    pointer = _selection_path(cache)
+    previous = pointer.read_bytes() if pointer.is_file() else None
+    _write_selection(cache, snapshot, record)
+    try:
+        return transcript.materialize_selected_reading(cache, selection_locked=True)
+    except (OSError, ValueError, transcript.SourceError):
+        if previous is None:
+            try:
+                pointer.unlink()
+            except FileNotFoundError:
+                pass
+        else:
+            transcript.atomic_write(pointer, previous)
+        raise
+
+
+def _selection(cache: Path, fallback: str) -> dict:
+    with transcript.selection_lock(cache):
+        return _selection_locked(cache, fallback)
+
+
+def _selection_locked(cache: Path, fallback: str) -> dict:
+    path = _selection_path(cache)
+    if not path.is_file():
+        _select_and_materialize_locked(cache, fallback)
+        return json.loads(path.read_text())
+    selection = json.loads(path.read_text())
+    snapshot = selection.get("snapshot")
+    if not isinstance(snapshot, str) or not snapshot:
+        raise CollectionError("selected snapshot pointer is invalid")
+    map_path = cache / "snapshots" / snapshot / "map.json"
+    if not map_path.is_file() or transcript.digest(map_path.read_bytes()) != selection.get("map_sha256"):
+        raise CollectionError("selected snapshot pointer does not match its bundle")
+    bundle, _ = transcript.resolve_bundle(cache, snapshot)
+    if not transcript.reading_materialization_matches(cache, bundle):
+        transcript.materialize_selected_reading(cache, selection_locked=True)
+    return selection
+
+
+def status(cache: Path) -> dict:
+    _, latest = transcript.resolve_bundle(cache, None)
+    latest_snapshot = latest["snapshot"]
+    selected_pointer = _selection(cache, latest_snapshot)
+    selected_snapshot = selected_pointer["snapshot"]
+    _, selected = transcript.resolve_bundle(cache, selected_snapshot)
+    selected_records = len(selected["pins"])
+    same_source = (
+        latest["source"]["path"],
+        latest["source"]["device"],
+        latest["source"]["inode"],
+    ) == (
+        selected["source"]["path"],
+        selected["source"]["device"],
+        selected["source"]["inode"],
+    )
+    same_conversation = latest["identity"] == selected["identity"]
+    same_context = transcript.contexts_equal(latest.get("context"), selected.get("context"))
+    selected_carryable = selected.get("history", {}).get("carry_forward_allowed", True)
+    latest_carryable = latest.get("history", {}).get("carry_forward_allowed", True)
+    latest_retained = (cache / "snapshots" / latest_snapshot / "source.jsonl").read_bytes()
+    selected_retained = (cache / "snapshots" / selected_snapshot / "source.jsonl").read_bytes()
+    complete_prefix_extended = (
+        len(latest_retained) > len(selected_retained)
+        and latest_retained.startswith(selected_retained)
+    )
+    return {
+        "selected_snapshot": selected_snapshot,
+        "latest_snapshot": latest_snapshot,
+        "selected_read": str((cache / "snapshots" / selected_snapshot / "read.md").resolve()),
+        "latest_read": str((cache / "snapshots" / latest_snapshot / "read.md").resolve()),
+        "selected_record": selected_pointer.get("record"),
+        "new_snapshot_available": latest_snapshot != selected_snapshot,
+        "new_records_available": (
+            latest_snapshot != selected_snapshot
+            and same_source
+            and same_conversation
+            and same_context
+            and complete_prefix_extended
+            and selected_carryable
+            and latest_carryable
+        ),
+        "selected_records": selected_records,
+        "latest_records": len(latest["pins"]),
+    }
+
+
+def _complete_prefix_unchanged(source: Path, cache: Path, context: dict, snapshot: str | None = None) -> bool:
+    """Whether a same-source poll adds no complete records to one retained bundle."""
+    _, latest = transcript.resolve_bundle(cache, snapshot)
+    if not transcript.contexts_equal(latest.get("context"), context):
+        return False
+    inspected = transcript.inspect_source(source, context)
+    provenance = inspected["provenance"]
+    old = latest["source"]
+    if (provenance["path"], provenance["device"], provenance["inode"]) != (
+        old["path"], old["device"], old["inode"],
+    ):
+        return False
+    if inspected["identity"] != latest["identity"]:
+        return False
+    return transcript.digest(inspected["retained"]) == latest["retained"]["sha256"]
+
+
+def collect_once(source: Path, cache: Path, context: dict) -> dict:
+    """Capture one complete-prefix snapshot without moving the reading selection."""
+    if (cache / "current.json").is_file() and _complete_prefix_unchanged(source, cache, context):
+        return {"published_snapshot": None, "complete_prefix_unchanged": True, **status(cache)}
+    published = transcript.publish(source, cache, context)
+    current = status(cache)
+    return {"published_snapshot": published["snapshot"], "complete_prefix_unchanged": False, **current}
+
+
+def _published_carries_selected(cache: Path, selected_snapshot: str, published_snapshot: str, context: dict) -> bool:
+    selected_bundle, selected = transcript.resolve_bundle(cache, selected_snapshot)
+    published_bundle, published = transcript.resolve_bundle(cache, published_snapshot)
+    if not transcript.contexts_equal(selected.get("context"), context):
+        return False
+    if not transcript.contexts_equal(published.get("context"), context):
+        return False
+    if selected["identity"] != published["identity"]:
+        return False
+    if not selected.get("history", {}).get("carry_forward_allowed", True):
+        return False
+    if not published.get("history", {}).get("carry_forward_allowed", True):
+        return False
+    old = selected["source"]
+    new = published["source"]
+    if (old["path"], old["device"], old["inode"]) != (new["path"], new["device"], new["inode"]):
+        return False
+    retained = (selected_bundle / "source.jsonl").read_bytes()
+    candidate = (published_bundle / "source.jsonl").read_bytes()
+    return len(candidate) >= len(retained) and candidate.startswith(retained)
+
+
+def refresh(source: Path, cache: Path, context: dict, record: str | None) -> dict:
+    """Move the selected view only after validating carry-forward from that selection."""
+    before = status(cache)
+    if record is None:
+        return {**before, "refreshed": False, "reason": "refresh blocked: no bookmark selected"}
+    _, selected = transcript.resolve_bundle(cache, before["selected_snapshot"])
+    if record not in selected["pins"]:
+        return {**before, "refreshed": False, "reason": "refresh blocked: bookmark is absent from selected snapshot"}
+    try:
+        carried = transcript.carry_forward(source, cache, before["selected_snapshot"])
+    except transcript.SourceError as exc:
+        return {**before, "refreshed": False, "reason": str(exc)}
+    except OSError as exc:
+        return {**before, "refreshed": False, "reason": f"refresh unavailable: source is missing or unreadable: {exc}"}
+    if _complete_prefix_unchanged(source, cache, context, before["selected_snapshot"]):
+        return {**before, "refreshed": False, "reason": "no newer complete records"}
+    published = transcript.publish(source, cache, context)
+    if not _published_carries_selected(cache, before["selected_snapshot"], published["snapshot"], context):
+        return {**status(cache), "refreshed": False, "reason": "refresh blocked: source changed during capture"}
+    _, latest = transcript.resolve_bundle(cache, published["snapshot"])
+    if record not in latest["pins"]:
+        return {**status(cache), "refreshed": False, "reason": "refresh blocked: bookmark is absent from newer snapshot"}
+    try:
+        reading = _select_and_materialize(cache, published["snapshot"], record)
+    except (OSError, ValueError, transcript.SourceError) as exc:
+        return {**status(cache), "refreshed": False, "reason": f"refresh blocked: selected reading update failed: {exc}"}
+    return {
+        **status(cache),
+        "refreshed": True,
+        "carry_forward": carried["carry_forward"],
+        "reading_materialized": str(reading) if reading is not None else None,
+    }
+
+
+def watch(source: Path, cache: Path, context: dict, interval: float, cycles: int):
+    if interval <= 0:
+        raise CollectionError("interval must be positive")
+    if cycles < 1:
+        raise CollectionError("cycles must be at least one")
+    for cycle in range(cycles):
+        try:
+            yield {"cycle": cycle + 1, "ok": True, **collect_once(source, cache, context)}
+        except (OSError, ValueError, transcript.SourceError) as exc:
+            yield {"cycle": cycle + 1, "ok": False, "reason": str(exc)}
+        if cycle + 1 < cycles:
+            time.sleep(interval)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    for name in ("collect", "refresh"):
+        command = commands.add_parser(name)
+        command.add_argument("--source", required=True, type=Path)
+        command.add_argument("--cache", required=True, type=Path)
+        command.add_argument("--project", required=True, type=Path)
+        command.add_argument("--vendor", required=True, choices=("codex", "claude-code"))
+        command.add_argument("--vendor-version", required=True)
+        command.add_argument("--input-format", choices=(transcript.SYNTHETIC_EVENT_FORMAT, *transcript.CODEX_NATIVE_FORMATS), default=transcript.SYNTHETIC_EVENT_FORMAT)
+        if name == "refresh":
+            command.add_argument("--record")
+    status_parser = commands.add_parser("status")
+    status_parser.add_argument("--cache", required=True, type=Path)
+    watch_parser = commands.add_parser("watch")
+    watch_parser.add_argument("--source", required=True, type=Path)
+    watch_parser.add_argument("--cache", required=True, type=Path)
+    watch_parser.add_argument("--project", required=True, type=Path)
+    watch_parser.add_argument("--vendor", required=True, choices=("codex", "claude-code"))
+    watch_parser.add_argument("--vendor-version", required=True)
+    watch_parser.add_argument("--input-format", choices=(transcript.SYNTHETIC_EVENT_FORMAT, *transcript.CODEX_NATIVE_FORMATS), default=transcript.SYNTHETIC_EVENT_FORMAT)
+    watch_parser.add_argument("--interval", required=True, type=float)
+    watch_parser.add_argument("--cycles", required=True, type=int)
+    args = parser.parse_args()
+    try:
+        context = None
+        if args.command in {"collect", "refresh", "watch"}:
+            context = {
+                "project": str(args.project.resolve(strict=False)),
+                "vendor": args.vendor,
+                "vendor_version": args.vendor_version,
+                "input_format": args.input_format,
+            }
+        if args.command == "collect":
+            result = collect_once(args.source, args.cache, context)
+        elif args.command == "refresh":
+            result = refresh(args.source, args.cache, context, args.record)
+        elif args.command == "status":
+            result = status(args.cache)
+        elif args.command == "watch":
+            for cycle in watch(args.source, args.cache, context, args.interval, args.cycles):
+                print(json.dumps(cycle, sort_keys=True), flush=True)
+            return 0
+        print(json.dumps(result, sort_keys=True))
+    except (OSError, ValueError, CollectionError, transcript.SourceError) as exc:
+        parser.error(str(exc))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
